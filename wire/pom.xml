<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo</artifactId>
        <version>0.5.1-SNAPSHOT</version>
    </parent>

    <artifactId>porelo-wire</artifactId>
    <name>Porelo Wire</name>
    <description>Porelo - Cross-boundary records, varlink and socket labeling (WIRE)</description>

    <!-- Apache-2.0, unlike the parent's license this replaces: the plugin contract, under the same license, builds on it. -->

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- Deployed to Central. Not interesting on its own - it is deployed because
             porelo-agent-api's pom names it, so resolving the agent API needs it too. -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <skipPublishing>false</skipPublishing>
    </properties>

    <build>

        <!-- The module's own license, in the jar, beside the classes it covers. -->

        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>

        <plugins>

            <!-- Published, so it carries a bill of its own dependencies. -->

            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>cyclonedx</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.fuin.porelo.wire</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Central rejects a release without these, and the parent only manages them. -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

</project>
