
# An agent binary installed on this machine.
type Agent (
  # Name the binary calls itself by, which is what Start takes.
  name: string,
  # Human-readable name.
  label: string,
  # The command it runs inside the container.
  binary: string,
  # The build this agent pins, from its own manifest, or "" when it pins none. NOT what the
  # binary answers if asked its version: nothing here executes it to find out, so two machines
  # showing the same value are running the same declared build.
  version: string,
  # Where the binary was found.
  from: string,
  # What the agent finds of itself on this machine, asked each time Agents is called, and presence
  # only: SIGNED_IN, NOT_SIGNED_IN or CANNOT_SAY, which an agent built before it can be asked
  # answers and is never not signed in.
  found: string,
  # The provider it was found signed in to, or "".
  foundProvider: string,
  # The paths found, its command on this account's PATH included.
  foundPaths: []string,
  # Hosts this agent needs, added to a task's egress on top of the project's own.
  # How this agent logs itself in, as arguments to its own binary, and where that is described.
  #
  # Declared by the agent, never guessed here: some agents open a browser and some print a link
  # and a code, and only the second kind works on a machine somebody reaches over ssh. A client
  # runs these in a TERMINAL on that machine - the login writes into the agent's own config
  # directory, and 'porelo vault import <agent>' then takes what it wrote into the vault.
  #
  # canLogIn is false for most agents: one whose credential is an API key has nothing to log in
  # to, and the manifest saying nothing is how it says so.
  canLogIn: bool,
  # What to run ON THAT MACHINE, in a terminal, to log this agent in. Empty when it cannot.
  #
  # Answered rather than composed by a client: a client that spells out 'porelo vault login
  # <agent>' is right until the day that verb moves, and then every client is wrong at once.
  loginCommand: []string,
  # What that command will run inside its throwaway container - the agent's own binary and
  # whatever it declared. Shown so a person can see what they are about to start; running it is
  # loginCommand's business, not a client's.
  loginArguments: []string,
  # Where that login is described, or "". Worth reading BEFORE running one on a remote machine.
  loginDocumentation: string,
  # How its sign-in works: "paste-code", "device-code" or "loopback". Absent when the definition
  # names none. A loopback sign-in is refused over SSH, before its container starts.
  loginFlow: ?string,
  allowedDomains: []string,
  # Hosts this agent declares and is deliberately NOT given. Not the same as absent from
  # allowedDomains: these were asked for and refused on purpose, which is worth showing beside
  # what was granted rather than leaving as a silence.
  refusedDomains: []string,
  # What this agent fetches when its image is built, each with the digest that pins it. Empty is
  # a real state and not a gap: an agent that writes its tool into the image fetches nothing, so
  # it has a pinned version and no digest at all.
  artifacts: []InstallArtifact,
  # The identity this agent's commits carry, from its own manifest. This is what tells a person
  # looking at a commit whether an agent or a person wrote it, and it is what the pre-push guard
  # on an operator's own checkout matches on.
  commitsAs: GitIdentity
)

# How an agent signs its work.
type GitIdentity (
  # Author name on its commits.
  name: string,
  # Author address on its commits.
  email: string
)

# One file an agent fetches while its image is built.
type InstallArtifact (
  # Where it is fetched from.
  url: string,
  # Expected SHA-256, or "" when there is none - in which case 'unverified' says whether that is
  # deliberate.
  sha256: string,
  # Absolute path it is installed at.
  target: string,
  # Whether it is knowingly unverifiable. An artifact with no digest and no reason is a mistake;
  # one with a reason is a decision somebody made and can be shown as such.
  unverified: bool,
  # Why it cannot be verified. "" unless 'unverified'.
  reason: string,
  # Who installs it: "root", before the agent's root steps, or "agent", as the agent's user.
  # Absent, from a daemon older than the field, means "agent".
  owner: ?string
)

# An installed agent binary that never runs: either an earlier location holds one of the same
# file name, or another binary claimed the same declared name first.
type ShadowedAgent (
  # The binary that is installed and not in use.
  path: string,
  # The one that runs instead. Locations are searched most specific first - the operator's own
  # directory, then the packaged one - so this is a rule and not an accident of scan order.
  usedInstead: string
)

# Agent binaries installed on this machine.
method Agents() -> (
  # One entry per agent NAME, never two: they are held by name, so a name appears once whatever
  # is installed. A second binary claiming a name already taken does not appear here at all - it
  # lands in 'failures'.
  agents: []Agent,
  # Binaries that are installed and could not be asked what they are, by file name. An agent
  # that fails to describe itself is unusable, and leaving it out would read as not installed.
  # A name collision is NOT here: nothing is broken in that case, one copy runs.
  failures: [string]string,
  # Binaries that are installed and never run. Two causes, one consequence: an earlier location
  # holds the same file name, or another binary claimed the same declared name first. Neither has
  # an Agent entry to carry a flag, which is why this is a list rather than a field on one.
  shadowed: []ShadowedAgent
)

# Which model providers this machine has, and which of them work could start against.
#
# The read half of authentication, and it carries no secret: names, kinds and whether something is
# stored, never a value.
#
# Cheap in the ordinary case. It consults the installed agents only when the vault holds a name
# that is not a provider's - the one situation where the key below can be an agent's name - so a
# vault written by a current Porelo costs nothing extra.
method Providers() -> (
  providers: []Provider,
  # Whether the vault could be read at all. False means locked or undecryptable, and then
  # 'authenticated' below is unknown rather than false - the same distinction Credentials draws,
  # for the same reason: "we cannot tell you until you unlock it" and "there is none" send a
  # person to different places.
  readable: bool
)

type Provider (
  # Short name, as an agent names it and as 'vault put' takes it.
  name: string,
  # Human-readable label.
  label: string,
  # Where requests are forwarded to.
  upstream: string,
  # Wire formats it serves, the provider's own first.
  dialects: []string,
  # Whether the vault holds a credential for it. MEANINGLESS unless 'readable' - render it only
  # beside that.
  authenticated: bool,
  # The kind stored: "api-key", "oauth", or "" when none is stored or none was recorded.
  credentialType: string,
  # The name a credential for this provider is stored under. Usually the provider's own name -
  # but a vault written before credentials were keyed by provider answers under the AGENT's name,
  # and that key stays in use so upgrading does not stop anyone authenticating.
  #
  # Computed here because a client cannot: intersecting "providers" with "stored names" reports a
  # missing credential for precisely the vault that has one, since the fallback key is invisible
  # from outside.
  credentialName: string,
  # The exact line to run at the machine to store one, ready to render verbatim. Always with the
  # provider's name, even when 'credentialName' is still an agent's: that is where it belongs, and
  # a task finds it there first. A subscription
  # token rather than an API key needs '--type oauth' on the end - they go in different headers,
  # and sending one as the other fails as an authentication error that looks like a wrong key.
  storeCommand: string
)

# What this machine could install, from its own package source.
#
# Nobody maintains a list: every agent package declares 'Provides: porelo-agent' and every transport
# 'Provides: porelo-transport', so the repository is the catalogue and a package published today is
# offered today. The names here are always real packages, never the virtual one - a virtual package
# with several providers cannot be installed by its own name.
#
# The message filter is deliberately absent. It is not one of a kind to choose from: it is the one
# thing without which nothing leaves, and it is always installed.
#
# As fresh as the machine's last index refresh, which needs root and is not done here.
method Installable() -> (packages: []Installable)

type Installable (
  # The real package name, which is what may be installed.
  name: string,
  # 'agent', 'transport' or 'homeserver'. What a person chooses between - the virtual package name that
  # this was read from ('porelo-agent', 'porelo-transport', 'porelo-homeserver') is the mechanism and is not
  # returned. A homeserver is what a transport's conversation runs on when the project names none of its
  # own; offer it beside the transport that needs it.
  kind: string,
  # One line, from the package itself.
  description: string,
  # Whether it is on this machine now.
  installed: bool,
  # What is installed, or what the repository offers. "" when neither is known.
  version: string
)

# The ecosystem adapters installed on this machine and, for a checkout, what each would place there at a first start,
# found as FirstStart finds them: the account's own directory first, then the packaged one, each asked Detect with the
# checkout's directory and the person's home. Nothing is looked up (no Resolve, so nothing reaches the network), and
# nothing is written, in the checkout or on the machine. A checkout of 'default' or of a placed project is asked alike.
# A checkout in no git repository, or not named by its absolute path, is FirstStartRefused with NOT_A_CHECKOUT.
method Ecosystems(
  # The checkout to ask about, by its absolute path. Without it only the adapters are listed.
  checkout: ?string
) -> (
  # Every installed adapter by name, one refused included, which is never asked about a checkout.
  ecosystems: []Ecosystem,
  # With a checkout: one entry per adapter that is not refused, in the order a first start asks them. Absent without.
  placing: ?[]EcosystemPlacing
)

# An installed ecosystem adapter, as its executable describes itself.
type Ecosystem (
  # Its executable's file name, which is the ecosystem it serves.
  name: string,
  # Where it is installed.
  executable: string,
  # Its own release, as it says it. Absent when it is refused or says none.
  version: ?string,
  # The version of org.fuin.porelo.Ecosystem1 it speaks. Absent when it is refused.
  protocolVersion: ?int,
  # Why it cannot be used, in words. Absent when it can.
  refusal: ?string
)

# What one adapter answers for a checkout. Every text an adapter wrote is made printable.
type EcosystemPlacing (
  # The adapter's name, as in Ecosystem.
  ecosystem: string,
  # DETECTED (it recognized something), NOT_RECOGNIZED (nothing of its tool is there), UNREADABLE (a file it needs
  # cannot be read; note says which) or FAILED (it did not answer, or answered no detection).
  outcome: string,
  # What it recognized, as it goes into a first start's draft. Empty unless DETECTED.
  findings: []EcosystemFinding,
  # What it read and can place in no part, with its words. Empty unless DETECTED.
  unplaced: []EcosystemUnplaced,
  # The settings files a first start places from it in a task. Empty today: a first start asks no adapter's Configure.
  files: []EcosystemFile,
  # What a first start says of an UNREADABLE or FAILED adapter, or "".
  note: string
)

# One value an adapter recognized, as org.fuin.porelo.Ecosystem1's Finding has it.
type EcosystemFinding (
  # TOOLS or RULES.
  part: string,
  key: string,
  value: string,
  # Where it is set; "" with line 0 when it comes from no file.
  file: string,
  line: int,
  # YOURS, CHECKOUT or MACHINE: who wrote it.
  origin: string,
  # Whether it is set where it cannot be read without running something.
  unknown: bool,
  note: string
)

# Something an adapter read and can place in no part.
type EcosystemUnplaced (file: string, line: int, note: string)

# A settings file an adapter would have placed in a task: its path, relative to the task user's home, and whether
# only that user may read it. Never what it holds, which may be a credential.
type EcosystemFile (path: string, ownerOnly: bool)

# The installed adapters could not be listed: detail names the directory.
error EcosystemsNotListed(detail: string)

# One installed agent's sign-in on this machine.
type AgentSignIn (
  # The agent, as Agents names it.
  agent: string,
  # Whether the vault holds the credential its sign-in makes, as a start reads it: SIGNED_IN,
  # NOT_SIGNED_IN, VAULT_LOCKED (shut: unknown until it is opened, never missing) or CANNOT_SAY (its
  # default provider cannot be used, so which credential a start needs is the start's choice).
  state: string,
  # The container of its sign-in that runs now, from a window or a terminal; "" while one is being
  # prepared and has no container yet. Absent when none runs.
  running: ?string
)

# Each installed agent's sign-in state, read from the vault once. A batch start asks this once and
# signs in each agent that is NOT_SIGNED_IN, one after another, before it starts its tasks.
method AgentSignIns() -> (signIns: []AgentSignIn)

# Starts an agent's own login on this machine, at most one per agent: one already running - started
# here or by 'porelo vault login' in a terminal - is answered instead, with started false.
#
# The login is no task. It runs detached, the agent's login as the container's first process and no
# shell around it, on the machine's own network and with the credential being made inside it, so
# List, Watch and Screen never see it. A window attaches to it with 'attach', run ON THAT MACHINE in a
# terminal; closing that terminal ends only the watching, never the sign-in, which ends with the login or
# at its 30-minute limit. The container is removed when the login ends. What the login makes is stored with
# what opened the vault when it started, under the provider the agent's sign-in names.
#
# Returns once the container runs, which the first time includes building the login image; a second
# call while one is being prepared returns once that one runs. A login nobody finishes within 30
# minutes is stopped and removed.
method AgentSignInStart(
  # The agent, as Agents names it.
  agent: string,
  # Signs in although this machine's own agent directory holds a sign-in. Without it that is
  # SignInRefused with ALREADY_SIGNED_IN, so the window offers ImportCredential first.
  force: ?bool,
  # Whether the person reaches this machine from another one. A LOOPBACK sign-in is then refused
  # with LOOPBACK_OVER_SSH: its redirect to this machine cannot reach their browser.
  remote: ?bool
) -> (
  # The login container, to attach to.
  container: string,
  # Whether this call started it.
  started: bool,
  # What to run on that machine to attach to the login.
  attach: []string
)

# Waits until an agent's sign-in ends, at most 30 minutes, and answers whether the vault holds its
# credential then - read from the vault, never from how the login exited. At once when none runs:
# after one that ended here, with its result; otherwise with what the vault holds.
method AgentSignInWait(agent: string) -> (
  # Whether the vault holds the agent's credential now.
  stored: bool,
  # Why not: the sign-in's outcome (NOTHING_TO_COLLECT, FAILED, NO_PROVIDER, ...), VAULT_LOCKED,
  # NOT_SIGNED_IN, CANNOT_SAY, NONE_RUNNING or TIMED_OUT; "" when stored.
  reason: string
)

# A sign-in could not start. reason is NO_SUCH_AGENT, UNSUPPORTED (the agent declares no login),
# LOOPBACK_OVER_SSH, NO_CONFIG_DIRECTORY, ALREADY_SIGNED_IN, VAULT_LOCKED (nothing could store what it
# makes), or FAILED (the image or the container could not be made); detail says it in words.
error SignInRefused(agent: string, reason: string, detail: string)
