# The person's gathered release of approved host main, using the same flow as porelo host push.
# Omitted or empty repositories select all from the person's checked push configuration, in order.
# Reads <forge>.central from this account's vault; refreshes <forge>.person through the existing
# checked sudo -n host issuer. Never prompts, reads a passphrase, opens askpass or adds a privilege.
# With more, progress contains only repository and stage: reading, pushing, pushed, up-to-date.
# Without more, only the final result is sent. The final reply lists confirmed pushed and unchanged
# repositories separately. NothingToPush means every selected main was already up to date.
# Stops on the first refusal. Error lists retain confirmed earlier completions; later repositories
# were not attempted. CentralPushUncertain means a started write may have completed: inspect before retry.
# A non-fast-forward brings central main to local central/main for a task merge and approval.
# Each Git process has a ten-minute deadline; streaming disconnect stops Git and later repositories.
# A one-shot caller may finish sending while still reading; its request is bounded by those deadlines.
# Issuance and transfer hold the account's forge-token lock, including against the CLI token issuer.
# No Git or issuer text, URL, credential or credential fragment is returned. Never offered through MCP:
# releasing to central is a person's judgment. The window offers this action; its button is a client concern.
method PushToCentral(project: string, repositories: ?[]string) -> (
  repository: ?string,
  stage: ?string,
  pushed: ?[]string,
  upToDate: ?[]string
)

# No process ran. unlock is init, passphrase, host or device; unlockCommand is an available command,
# or empty for the enrolled device flow. A host command's <host> is filled in by the person's client.
error CentralVaultShut(unlock: string, unlockCommand: []string)

# No usable central credential exists at this exact vault key; no process ran.
error MissingCentralToken(credential: string, storeCommand: []string)

# Central refused authentication; forge and status carry checked HTTP evidence when available.
# Every selected receive endpoint is checked before any push, including public repositories.
# storeCommand is empty: this refusal never asks for a replacement token. No Git prompt text.
error CentralTokenRefused(credential: string, storeCommand: []string, repository: string, pushed: []string, upToDate: []string, forge: ?string, status: ?int)

# Every selected repository was confirmed unchanged, rather than newly pushed.
error NothingToPush(pushed: []string, upToDate: []string)

# The existing noninteractive issuer could not supply a local token, or another transfer holds its lock.
# reason is issuer or busy. Check the host's existing sudo rule; the daemon will not ask a password.
error HostPushTokenUnavailable(reason: string, storeCommand: []string)

# The central write was refused. reason is central-refused or reconcile; branch is central/main for
# reconciliation, otherwise empty. Merge and approve central/main in a task before trying again.
error CentralPushRefused(repository: string, reason: string, branch: string, pushed: []string, upToDate: []string)

# A started write timed out, was interrupted or lost its connection; its remote outcome is unknown.
error CentralPushUncertain(repository: string, pushed: []string, upToDate: []string)

# Host trust/preflight or local transfer failed. reason is selection, account, settings, program,
# configuration, authority, vault, transfer or unexpected. Repair the named category before retrying.
# code is the corresponding host command exit code, never a process diagnostic.
error HostPushRefused(reason: string, code: int, repository: string, pushed: []string, upToDate: []string)


# A host forge review, observed with this account's person token.
type HostPullRequest (
  # The repository key in project.yml, not the forge's display name.
  repository: string,
  number: int,
  # Outside text for plain-text display: controls and line separators removed, at most 1000 code points.
  title: string,
  # A full 40- or 64-digit lowercase hexadecimal commit id.
  head: string,
  # Makers of exactly head, read from the local mirror or the head fetched from the host's forge
  # into Porelo's own store, never from the forge's user fields.
  # Author, committer and each trailer are shown text cut to 1000 code points.
  author: string,
  committer: string,
  # At most 50 Assisted-by and Co-Authored-By trailers, unfolded by git.
  trailers: []string,
  # open, merged or closed. These are observations, not signature or approval judgments.
  state: string
)

# A carried repository whose reviews could not be read this round while the others' were.
type HostPullRequestRefusal (
  # The repository key in project.yml.
  repository: string,
  # forge-access (403 or 404: its copy is not made yet or the person is not admitted), forge (any
  # other status), or not-carried (an earlier row of a repository the host no longer carries).
  reason: string,
  # The forge's HTTP status; absent when the forge was not asked.
  status: ?int,
  # The path asked, as /api/v1/repos/<copy>/pulls or /pulls/<n>: never the host's address or query.
  path: ?string,
  # Porelo's words with the status, the path and what to do; never the forge's words or the token.
  message: string
)

# Reads open reviews the daemon account's person token can see in this project's carried repositories.
# Uses <name>.person from the vault, with name and git_port from the checked root-owned forge settings.
# Takes an unplaced carried project once before reading, checking its signed project file as a start does.
# Missing mirror heads are fetched from their loopback copies into the reader's own state store.
# The person token reaches git only in its environment; redirects stay off and the gate mirror is never written.
# Every page of every carried repository is read, as far as the forge says the list goes: a page shorter
# than asked is no end; a Link header without a rel="next" page, or failing that X-Total-Count, is. A forge
# that says neither is read to its first empty page. One HTTP answer may hold 32 MiB.
# A bound is a refusal, never a truncated successful list.
# HTTP has no proxy or redirects, connects within 10 seconds and answers within 20 seconds.
# Each git maker query has a 10-second deadline and a 64 KiB output limit.
# A review fetch is shallow, with 20 seconds per git command and a 32 MiB pack/file limit.
# refused, present only when a repository was refused, names each; the other repositories still answer.
# A reply fits one message: when the rows do not, pullRequests and ended hold their first rows, paged says how
# many there are, and PullRequestsPage gives the rest of this same reading. Absent when every row is here.
method PullRequests(project: string) -> (pullRequests: []HostPullRequest, ended: []HostPullRequest, refused: ?[]HostPullRequestRefusal, paged: ?PullRequestsPaged)

# How much of a PullRequests reading or a WatchPullRequests snapshot there is when its reply holds only the
# first rows.
type PullRequestsPaged (
  # Names the reading, which the daemon keeps ten minutes for PullRequestsPage: 32 lowercase hexadecimal digits.
  reading: string,
  # How many rows the reading holds in pullRequests and in ended.
  pullRequests: int,
  ended: int,
  # Where the next page starts, as PullRequestsPage.from.
  next: int
)

# The rest of a PullRequests reading or a WatchPullRequests snapshot that did not fit its reply, page by page:
# positions run through pullRequests and then ended, so putting the pages after the first reply gives each list
# whole, in its order, every row once. Each page fits one message.
method PullRequestsPage(
  project: string,
  # PullRequests.paged.reading or WatchPullRequests.paged.reading.
  reading: string,
  # paged.next, or a page's next. A position at or past the reading's last row, or below 0, answers
  # InvalidParameter naming from.
  from: int
) -> (
  pullRequests: []HostPullRequest,
  ended: []HostPullRequest,
  # Where the next page starts; absent when this page ends the reading.
  next: ?int
)

# The reading is not kept: ten minutes have passed since PullRequests or a watch answered it, later readings
# took its place, the daemon started again, or it is no reading of this project. The client asks PullRequests
# again, or takes the watch's newer snapshot.
error PullRequestsReadingGone(project: string, reading: string)

# Without more, one snapshot as PullRequests. With more, an initial snapshot (including empty), then
# changed snapshots, polling five seconds after each completed round; rounds never overlap.
# Takes the project once before the first round, never on subsequent rounds.
# pullRequests is the whole current open list. ended contains each previously observed review that
# was explicitly confirmed merged or closed, once per transition. Its terminal event ends that row,
# not this watch. Reviews opened and ended entirely between polls need not be observed.
# Absence alone, HTTP failure, lost access and missing maker objects never mean closed. A refused
# repository's earlier rows are kept, neither open nor ended, until it answers again; a named error
# ends the stream, and the client must treat its retained rows as stale and ask again. The stream ends only
# on a named error of this method's own; PullRequestsReadingGone is only ever an answer to PullRequestsPage.
# A snapshot that does not fit one message carries its first rows and paged, as PullRequests does: it is a
# reading of its own, kept as PullRequests readings are, whose rest PullRequestsPage gives while the watch
# goes on. A snapshot that fits carries no paged. A newer snapshot's reading may take an older one's place,
# so a client still paging an older snapshot drops it for the newer.
# None of PullRequests, PullRequestsPage and this method is offered to tasks through MCP: each spends or
# hands out what the person's forge identity read.
method WatchPullRequests(project: string) -> (pullRequests: []HostPullRequest, ended: []HostPullRequest, refused: ?[]HostPullRequestRefusal, paged: ?PullRequestsPaged)

# No usable person token exists under the exact entry written by the command on this host.
# storeCommand carries --if-forge, so it does nothing on a host without a forge.
error MissingHostForgeToken(credential: string, storeCommand: []string)

# Safe diagnostic with no forge or process output. Taking may refuse with its project reason.
# Read reasons: settings, vault-unreadable, not-carried,
# forge-token (the forge answered 401: renew the token), forge, forge-answer, makers, bounds. Unlock/repair an unreadable vault before retrying; missing is distinct.
error HostPullRequestsRefused(reason: string, message: string)

# A push waiting at the gate for a decision.
type PendingPush (
  # Ref name under refs/porelo/incoming/, which is what Review, Approve and Reject take.
  name: string,
  commit: string,
  # First line of the commit message.
  subject: string,
  # How long it has been waiting, as words: "4 minutes".
  waiting: string,
  # When it arrived, ISO-8601.
  at: string,
  # The `git fetch` that brings this push into a person's own clone of the repository, over their
  # ssh, as "git fetch ssh://<user>@<host><mirror> refs/porelo/incoming/<name>:refs/remotes/porelo/<name>".
  # The host is this machine's own name; a client that reached it by another may put that one in.
  # Reading only: the work is the agent's and not reviewed - say to open it in the IDE's safe mode,
  # and never to build or test it outside a container.
  fetch: string,
  # Whether the upstream already has this work: somebody pushed it there by hand, past the gate, as the last
  # measurement of the upstream found. Reject refuses it without 'force'. Absent from a daemon before this field.
  alreadyUpstream: ?bool,
  # Who made the head commit, "name <email>" as git has them, and its message's trailer lines, unfolded, as git
  # reads them ("Assisted-by: ..."). Shown as they come, never judged here. Absent from a daemon before these
  # fields, for a ref that is not a commit, and when the ref has moved past `commit`. Each is cut at 1000 code
  # points, and at most 50 trailers are given.
  author: ?string,
  committer: ?string,
  trailers: ?[]string,
  # The head commit's whole message, cut at 16384 code points: a Co-Authored-By outside git's trailer block is
  # in no trailer line, and is here. Absent where author is, and when git's answer could not be matched to
  # the commit.
  message: ?string,
  # What the gate decided when this commit arrived, as the account's event log records it: "accepted" when the
  # task's certificate judged it, "accepted, unsigned" when the task has none and nothing could judge it. A
  # checker's verdict, never the task's word. Absent when no arrival of this commit is recorded, and from a
  # daemon before this field.
  # Text for a person, shown and not parsed: today "accepted" or "accepted, unsigned", and an open set.
  arrival: ?string
)

# One commit of a pending push, with who made it.
type ReviewCommit (
  # In full.
  commit: string,
  # First line of the message.
  subject: string,
  # "name <email>", as git has them.
  author: string,
  committer: string,
  # The message's trailer lines, unfolded, as git reads them; empty when it has none. Subject, author, committer
  # and each trailer are cut at 1000 code points, and at most 50 trailers are given.
  trailers: []string,
  # The whole message, cut at 16384 code points; "" when git's answer could not be matched to each commit.
  message: string
)

# One file a pending push changes, as a person should meet it in a review.
#
# Ranked by consequence, not by suspicion: nothing here detects anything. DANGEROUS is a fixed list of
# kinds Porelo ships - a CI definition, a build script, a dependency manifest or lockfile, something that
# runs on checkout or when the repository is opened, a file made executable, a symbolic link - and is
# named however small the change. GENERATED and REFORMATTING are what is almost never the finding; they
# are moved to the end, never hidden, and a dangerous file is never either.
type ReviewFile (
  # Its path in the repository, after the change. A rename is a removal and an addition.
  path: string,
  # A, M, D or T, as git reports it.
  status: string,
  # Lines added and removed; -1 for a binary file.
  added: int,
  removed: int,
  # Counts over the same range, with git's --ignore-space-at-eol; -1 for binary files.
  # Absent from older daemons. This also ignores trailing spaces, not only CRLF changes.
  addedIgnoringLineEndings: ?int,
  removedIgnoringLineEndings: ?int,
  # DANGEROUS, ORDINARY, GENERATED or REFORMATTING - the order to read them in.
  rank: string,
  # Why it has that rank, in words; "" for an ORDINARY file.
  reason: string,
  # The delivery this file came in through: its content at the push is exactly a file Porelo
  # handed into the task, at any path. Absent for the agent's own work, and from older daemons.
  origin: ?DeliveredOrigin
)

# Where a pushed file came from, when Porelo delivered its content into the task.
type DeliveredOrigin (
  # HAND_IN: a file handed into /porelo/files.
  kind: string,
  # The delivered file's name.
  name: string,
  # Who delivered it: an account, or "porelo".
  by: string,
  # When, UTC.
  at: string,
  # The delivered content's sha256, hex.
  sha256: string
)

# ---------------------------------------------------------------------------- the gate

# What is waiting at a project's gate.
#
# The gate methods take a project NAME rather than a task, because a gate belongs to a project and
# one daemon serves every project the operator has.
#
# A NAME and not a path: a client cannot see this machine's filesystem and has no path to invent,
# and which project a call is about must not depend on a directory. The machine resolves it, and
# prefers the file it verified - so a call and a task cannot end up reading two different files.
#
# Each of them also takes 'repository', because a gate belongs to ONE REPOSITORY of that project:
# every repository has its own mirror, its own review branch and its own answer to "what is waiting
# for review". Omitting it means the project's own repository - the one the project file belongs
# to - which is the only default in this interface that is not Porelo picking between equals.
# Project.repositories lists the names.
method Pending(
  # Project NAME, as Projects.name gives it.
  project: string,
  # Upstream to gate against. Default: the project's own.
  upstream: ?string,
  # Which repository of the project. Default: the project's own.
  repository: ?string
) -> (
  # Path to the bare mirror the agent pushes into.
  mirror: string,
  # offline, gatekeeping or online.
  mode: string,
  # Where the mirror was seeded from, or "" when it was not.
  seededFrom: string,
  pending: []PendingPush
)

# What a pending push contains, so it can be judged before it is forwarded.
method Review(
  project: string,
  upstream: ?string,
  # Which repository of the project. Default: the project's own.
  repository: ?string,
  # Ref name, from PendingPush.name.
  name: string,
  # What to diff against. Default: the task's recorded starting branch, or the mirror's HEAD for older tasks;
  # with none in the mirror, the whole history to the commit. A named ref or commit the mirror does not hold
  # is refused as Failed, never taken as no base.
  against: ?string,
  # Ignore whitespace at line endings in the diff (git --ignore-space-at-eol). Default: false.
  # Counts, file ranking and log are unchanged by this switch.
  ignoreLineEndings: ?bool
) -> (
  # The full commit whose evidence is returned, for Approve.commit. Absent from older daemons.
  commit: ?string,
  # Unified diff, in the order of files: the dangerous first, reformatting and generated files last.
  diff: string,
  # Commit log over the same range: every commit it lists is in diff and files.
  log: string,
  # The same commits, newest first, each with who made it. Absent from a daemon before this field.
  commits: ?[]ReviewCommit,
  # What the push changes, ranked; the diff shows them in this order.
  files: []ReviewFile,
  # What the task that pushed this was asked, to show before the files - never compared with them.
  # "" when it was started without an instruction; absent when the task is gone from this machine.
  asked: ?string,
  # What the gate decided when the waiting commit arrived, as PendingPush.arrival says it. Absent when no
  # arrival of it is recorded, and from a daemon before this field.
  # Text for a person, shown and not parsed: today "accepted" or "accepted, unsigned", and an open set.
  arrival: ?string,
  # Present when diff is not the whole patch: the reply would not fit one message. diff then ends at a file
  # boundary and never holds part of a file. files, their ranks and log stay whole; the ranking was made
  # from the whole change. Absent when diff is whole, and from a daemon before this field.
  cut: ?ReviewCut,
  # Present when files, commits, log or diff holds only its first page; ReviewPage gives the rest. Absent
  # when all of it is here.
  paged: ?ReviewPaged
)

# Where a Review's diff was cut to fit one message.
type ReviewCut (
  # Files whose patch is in diff, and files whose patch is not.
  shownFiles: int,
  omittedFiles: int,
  # The omitted files' paths, in the diff's order: each is in Review.files with its rank.
  omitted: []string,
  # The command that prints the whole review, patch included, on the daemon's machine.
  command: []string
)

# How much of a Review there is when a part of it holds only its first page; ReviewPage gives the rest.
type ReviewPaged (
  # Each part's whole size: entries for files and commits, UTF-8 bytes for log and diff.
  files: int,
  commits: int,
  logBytes: int,
  diffBytes: int,
  # Each part's next page, as ReviewPage.from; absent where Review already holds all of that part.
  filesNext: ?int,
  commitsNext: ?int,
  logNext: ?int,
  diffNext: ?int,
  # The full base commit Review resolved and read against, "" for the whole history: ReviewPage.against.
  base: string
)

# The rest of a Review that did not fit its reply, page by page, for the commit that Review answered. Pages of
# files and commits are in Review's own order, so putting them together gives the list Review would have given
# whole. Each page fits one message.
method ReviewPage(
  project: string,
  upstream: ?string,
  repository: ?string,
  name: string,
  # Review.commit; refused as MovedSinceReview when the push has moved since, so every page is of one commit.
  commit: string,
  # Review.paged.base: the pages are of <against>..<commit>, the whole history to commit when "". Never a
  # default resolved again, so a base that moved since Review cannot change the pages; anything but "" or a
  # full commit is refused as InvalidParameter naming against.
  against: string,
  # As Review was asked with it.
  ignoreLineEndings: bool,
  # "files", "commits", "log" or "diff"; another is refused as InvalidParameter naming part.
  part: string,
  # Where this page starts: Review.paged's next for the part, or a page's next. A position the daemon did not
  # give - past the part's end, or not at the start of an entry, a line, or for diff a file - is refused as
  # InvalidParameter naming from.
  from: int
) -> (
  # The one that matches part; the others absent.
  files: ?[]ReviewFile,
  commits: ?[]ReviewCommit,
  text: ?string,
  # Where this part's next page starts; absent when this page ends it.
  next: ?int
)

# Review's file list, commits and log alone do not fit one message: nothing is sent rather than a list a
# person would take for the whole. bytes is what that reply would take; command prints the whole review
# on the daemon's machine.
error ReviewTooLarge(name: string, bytes: int, limit: int, command: []string)

# Forwards a pending push upstream. The only call in this interface that sends anything
# anywhere. Without a branch named it goes to the task's branch - porelo/<task> unless the task's start
# named another - on every upstream, the host's own forge or a plain git remote alike; the starting
# branch only when named. On the host's own forge approval opens or reuses a pull request with
# the task's token, targeting the repository's default branch. If the API refuses, Failed says
# the push happened and why the forge refused; the approval stays pending for a retry.
method Approve(
  project: string,
  upstream: ?string,
  # Which repository of the project. Default: the project's own.
  repository: ?string,
  name: string,
  # Branch to push to. Omitted or empty means the task's own branch (Task.forgeBranch), porelo/<task> for
  # work whose task is no longer recorded; BranchRequired when neither is known. In a project with a branch
  # block the task's must be recorded, and a named one must match its branch.pattern, or the answer is
  # BranchRefused.
  branch: ?string,
  # Merge the work onto the branch as a commit signed with the signing key the daemon's user has configured
  # in git (user.signingkey; gpg.format ssh for an ssh key), and push that, rather than pushing the work as
  # it is. For what the project's configuration is made of - a machine's enrolment - which every machine
  # accepts only signed with the project's key. The machine never holds the key; git signs. Refused as
  # Failed when the merge cannot be made or comes out unsigned. From the daemon an ssh-agent is reached only
  # if its socket is in the daemon's environment; 'porelo gate approve --signed' in a terminal always is.
  signed: ?bool,
  # The full lowercase 40- or 64-digit commit the person reviewed, as Review.commit answers it.
  # Optional on the wire for compatibility; omitted or blank is refused as CommitNotNamed.
  # Refused as MovedSinceReview when the push has moved since, so what goes is what was read.
  # Refused as BranchExists when 'branch' holds work the commit did not grow from, unless its head
  # is, on the host's forge, the last commit this gate forwarded for this task; that head is then
  # replaced with a lease.
  commit: ?string
) -> (
  forwarded: string,
  branch: string,
  # Address of the new or reused pull request on the host's forge; absent elsewhere.
  pullRequest: ?string
)

# Pending work as a git bundle, for a person who merges it on their own computer - signed with their own key -
# and pushes it: what is on the pending ref and not on 'branch' in the mirror (the whole history when the mirror
# has no such branch). Fetch it with 'git fetch <file> refs/porelo/incoming/<name>'. Refused as BundleTooLarge
# above the limit, rather than sent: a reply is one message.
method PendingBundle(
  project: string,
  upstream: ?string,
  # Which repository of the project. Default: the project's own.
  repository: ?string,
  name: string,
  # The branch it is to be merged onto. Default: the task's own branch, as Approve chooses it; with a branch
  # block, a named one must match its branch.pattern (BranchRefused otherwise).
  branch: ?string
) -> (
  # The bundle, base64.
  bundle: string,
  bytes: int
)

# Clears pending work that was merged elsewhere and pushed, once the upstream's 'branch' holds its commit -
# fetched with this machine's own credential. Not rejected, which it was not: it went, just not through here.
# landed false changes nothing, and 'detail' says why: not on the branch yet, the upstream not reachable, no
# upstream configured.
method Landed(
  project: string,
  upstream: ?string,
  # Which repository of the project. Default: the project's own.
  repository: ?string,
  name: string,
  # The upstream branch it was merged onto. Required.
  branch: string
) -> (landed: bool, commit: string, detail: string)

# The bundle is larger than a reply may be.
error BundleTooLarge(bytes: int, limit: int)

# Drops a pending push. The work stays in the mirror; only the request is gone.
#
# The task the work came from is told in its inbox, with the person's words when 'reason' gives them - an
# agent whose work silently vanished hands it over again. 'told' is false when no task of that name has a
# mailbox here any more.
# 'force' discards a push the upstream already has (PendingPush.alreadyUpstream); without it such a push is
# refused with AlreadyUpstream and nothing is discarded.
method Reject(project: string, upstream: ?string, repository: ?string, name: string, reason: ?string, force: ?bool)
    -> (rejected: string, told: bool)

# Reject was asked to discard a push the upstream already has, and was not given 'force': nothing was discarded.
error AlreadyUpstream(name: string)

# Approve was given the commit the person reviewed, and the push has moved since - before the call, or
# while a signed approval fetched the upstream: nothing was forwarded. Review it again (now is what it
# holds) and approve that. Comment and Reply are refused the same way, and keep nothing; ReviewSummary
# too, and counts nothing.
error MovedSinceReview(name: string, reviewed: string, now: string)

# No approval was attempted. waiting is the full commit that waits now and could be forwarded; a name
# nothing waits under, or a gate that forwards nothing, is refused as Failed instead, with what does wait.
# Review that revision before making a new authenticated Approve call with its commit.
# SARIF verdicts, suppressions, baselines and empty findings never authorize forwarding.
error CommitNotNamed(name: string, waiting: string)

# Approve was called without a branch to push to, and the task's own is not known: in a project with a
# branch block, not recorded; without one, not recorded and the pending push's name is no task's.
error BranchRequired(name: string)

# Approve or PendingBundle named a branch the project's branch.pattern does not accept, so the forge's
# rules would not cover it: nothing was pushed. Name one the pattern accepts, or none for the task's own.
error BranchRefused(branch: string, pattern: string)

# Approve's branch holds work the reviewed commit did not grow from - earlier work of a task whose name came back:
# nothing was pushed. 'at' is the commit the branch holds. Approve onto another branch, such as the next free
# '<branch>-2'; never a force over it, since it can be somebody's reviewed work.
error BranchExists(branch: string, at: string)

# Opens a comment thread on lines of a waiting push, as the owner account. Kept with the push and bound to
# the task container that pushed it, so a later task of the same name inherits no thread. Never offered
# through MCP: a task answers in a thread through its mailbox.
method Comment(
  project: string,
  # Which repository of the project.
  repository: string,
  # Ref name, from PendingPush.name.
  name: string,
  # The full commit the caller reviewed, from Review.commit; a push that moved past it is refused as
  # MovedSinceReview, since the lines would point into another change.
  commit: string,
  # The file's path in the repository, as Review.files names it.
  path: string,
  # old (the review's base) or new (the reviewed commit).
  side: string,
  # The lines on that side, counted from 1, both ends included; endLine is never before startLine.
  startLine: int,
  endLine: int,
  # What the comment says, as plain text.
  text: string,
  # Lines proposed in place of startLine to endLine, on the new side only; "" proposes taking them out.
  replacement: ?string,
  # A retry id: the same id with the same comment answers the comment kept first, never a second one.
  id: ?string
) -> (
  # The comment's own id, and the thread it opened.
  guid: string,
  thread: string
)

# Answers a thread of a waiting push, as the owner account; open or resolved, the thread keeps its state.
method Reply(
  project: string,
  repository: string,
  name: string,
  # The full commit the caller reviewed; refused as MovedSinceReview when the push moved past it.
  commit: string,
  # The thread's id, as Comment or Comments gave it.
  thread: string,
  text: string,
  # A retry id, as for Comment.
  id: ?string
) -> (
  guid: string,
  thread: string
)

# Every comment and reply of a waiting push, as SARIF in Porelo's profile, one page at a time, the oldest
# thread first. Each item names its producer by channel: the owner account, or a task.
method Comments(
  project: string,
  repository: string,
  name: string,
  # Where the page starts, from the last page's cursor; absent for the first.
  cursor: ?string
) -> (
  # The SARIF document of this page.
  sarif: string,
  # Where the next page starts; absent after the last.
  cursor: ?string
)

# Sets a thread of a waiting push resolved, or open again with reopen. Only the thread's state changes: it
# clears no finding, changes no approval and approves nothing.
method ResolveThread(
  project: string,
  repository: string,
  name: string,
  thread: string,
  # Opens the thread again instead. Default: false.
  reopen: ?bool
) -> (
  thread: string,
  # open or resolved.
  state: string
)

# How much of a waiting push's review is still open, as the daemon counts it, for whoever decides the push.
# Never offered through MCP. Refused only as NoSuchPush or MovedSinceReview.
method ReviewSummary(
  project: string,
  repository: string,
  # Ref name, from PendingPush.name.
  name: string,
  # The full commit the caller reviewed; refused as MovedSinceReview when the push moved past it, so the
  # counts are of the commit that was read.
  commit: string
) -> (
  # Findings not yet answered.
  openFindings: int,
  # Threads still open; a resolved thread is not counted.
  openThreads: int,
  # Each run that reviewed the push; empty when none did, never a run made up.
  runs: []ReviewRun
)

# One run that reviewed a push.
type ReviewRun (
  name: string,
  # How completely it reviewed: complete, partial, failed or unknown.
  completeness: string,
  # How many findings it gave.
  findings: int
)

# What is open at a place for one task, and the place's decision, read anew from the gate's records and
# the forge's answer at each call; Porelo stores nothing for it and starts nothing. Every time is UTC,
# RFC 3339, in whole seconds. Never offered through MCP. 'porelo review open --json' answers the same.
# Refused as PlaceUnreadable, UnknownForge, NoPullRequest, for a pull request address the forge does not
# know as NoSuchPullRequest, and as HeadNotInGate for a pull request whose head the asking task's gate never
# forwarded; pullRequest or ownPullRequest without task is org.varlink.service.InvalidParameter.
method ReviewOpen(
  project: string,
  place: Place,
  # The task whose run asks; required for pullRequest and ownPullRequest, whose side and held items are its.
  # Absent at a gate push it is the task that pushed. The answer follows that task's recorded parts.
  task: ?string
) -> (
  # The commit reviewed at the place: at the gate the push's waiting head, on a pull request its head, for a
  # MERGED one the head that merged. Absent when nothing stands there any more.
  head: ?string,
  # At the gate: OPEN while the push waits, RETURNED after a Reject that carried open threads, REJECTED
  # after one that carried none, APPROVED when Approve forwarded it, LANDED when Landed found it merged
  # elsewhere. On a pull request: OPEN, APPROVED (an approving review stands), MERGED, CLOSED (unmerged).
  decision: (OPEN, RETURNED, REJECTED, LANDED, APPROVED, MERGED, CLOSED),
  # The task that rejected the push, by its name: set exactly when decision is RETURNED or REJECTED and a
  # task holding the right reject made it, with decisionSince the time it did. Absent when the owner
  # account rejected, and for every other decision. The event log's rejected entry names the same task
  # in its detail.
  rejectedBy: ?string,
  # The forwarded commit at the gate, the merge commit on a pull request; absent until one exists.
  mergedCommit: ?string,
  # The branch that commit went onto, at both places, such as "main"; absent with mergedCommit.
  mergedHead: ?string,
  # When the current decision began: at the gate when the push started waiting or when its Reject,
  # Approve or Landed was recorded; on a pull request when it was merged or closed, and absent while
  # it is OPEN or APPROVED, since the forge does not say when its head was pushed. Absent also when
  # complete is false for a missing time.
  decisionSince: ?string,
  # Open threads whose last item is not the asking task's: at a gate push not written by that task, on a
  # pull request not by the account its start recorded. Resolved threads and held items are none.
  points: []OpenPoint,
  # Findings no one answered, counted apart from points.
  findings: int,
  # Review items held back from the run at this place.
  held: int,
  # False when part of the answer could not be read; reason then says which part.
  complete: bool,
  # Why complete is false; absent when complete. TimeMissing: a forge answered no time for an item.
  # JournalUnreadable: the review journal could not be read, so findings is 0. On a pull request also
  # RateLimited (the forge asked to wait before every page was read), PagePartial (a page was cut short) and
  # PageRefused (a page broke the review profile and was not read).
  reason: ?string,
  # A digest of this answer; equal versions are equal answers.
  version: string
)

# An open thread, as ReviewOpen counts it.
type OpenPoint (
  thread: string,
  # The file the thread is on; absent for a thread on the whole push.
  path: ?string,
  # The thread's first line on that file; absent with path.
  line: ?int,
  # Who wrote the thread's last item: "owner account", "task <id>", or the forge's login.
  lastBy: string,
  # When the thread's last item was written. An item written before items carried a time reads as
  # the time its push started waiting.
  lastAt: string
)

# A pull request address the forge does not know; nothing was made.
error NoSuchPullRequest(url: string)

# A pull request's head the asking task's gate never forwarded, so no comment on it can be judged; 'head' is
# the commit looked for.
error HeadNotInGate(head: string)

# One review item held for the owner account's decision. Outgoing items come from a task's run and go to its
# place once released; incoming items come from the place and reach the run once passed. Only undecided items
# are listed.
type HeldItem (
  # The hold's id, which DecideItem names.
  id: string,
  # The task whose run it belongs to.
  task: string,
  # The place's name: a pull request's https address, or a gate push's "<repository>/<name>".
  place: string,
  direction: (outgoing, incoming),
  # Where it goes: for an outgoing item the place, for an incoming one the task's run.
  destination: string,
  # What it does there: comment (opens a thread at a file's lines), reply (answers a thread) or resolve (marks a
  # thread resolved; only a task's run sends one).
  operation: (comment, reply, resolve),
  # A comment's file, repository-relative; absent for a reply.
  path: ?string,
  # A comment's side: old (the base's file) or new (the reviewed commit's); absent for a reply.
  side: ?(old, new),
  # A comment's first and last line, inclusive, counted from 1; absent for a reply.
  startLine: ?int,
  endLine: ?int,
  # The thread a reply answers or a resolve marks, by its id at the place; absent for a comment.
  thread: ?string,
  # A comment's proposed replacement of its lines, exact and unescaped; absent when it has none.
  suggestion: ?string,
  # The commit the run pinned, in full; the item is written against it.
  commit: string,
  # The item's exact text, unescaped: what is released is exactly this; absent for a resolve, which says nothing.
  text: ?string,
  # SHA-256 of the item's content (operation, path, side, lines, thread, text, suggestion; for a resolve the place,
  # the pinned commit and the thread) in lowercase hex, as Porelo computes it; DecideItem names the digest it was
  # shown, and a client never computes it.
  digest: string,
  # The name of the forge account that wrote an incoming item, such as "octocat", which a client shows as
  # "forge account octocat"; absent for an outgoing one.
  from: ?string,
  # Absent: the item came through a message its task signed with its certified key. unsigned: no certified key
  # of the task signed it, as for a reviewer task off a host. Only an outgoing item carries it.
  mark: ?(unsigned),
  # When it was held, UTC, RFC 3339, whole seconds.
  at: string,
  # The run's number at its place for its task, from 1.
  run: int
)

# The undecided held items, oldest first, in pages. Never offered through MCP: the decision is the owner
# account's. A cursor is refused as CursorRefused.
method HeldItems(
  # A task's name; absent lists every task's items on this machine.
  task: ?string,
  # From a previous answer's cursor; absent for the first page.
  cursor: ?string
) -> (
  items: []HeldItem,
  # The next page's cursor; absent on the last page.
  cursor: ?string,
  # Without a task: each entry of the hold store whose journal cannot be read, or that is no task's, by
  # name; its items are left out and every other task's listed. Absent when every journal was read.
  unreadable: ?[]string
)

# Decides one held item, if its content is still the one shown. release and refuse are for an outgoing item,
# pass and dismiss for an incoming one; another is org.varlink.service.InvalidParameter. A refusal carries no
# words for the task. The reply is empty; the item leaves HeldItems and Task.held. Never offered through MCP.
method DecideItem(
  task: string,
  id: string,
  # The digest the decider was shown.
  digest: string,
  decision: (release, refuse, pass, dismiss)
) -> ()

# No held item of that id for that task.
error NoSuchItem(id: string)

# The item's content is not the one its digest names; nothing was decided.
error DigestChanged(id: string)

# The item was decided before.
error AlreadyDecided(id: string)

# A later run of its task began at its place, so it can no longer be decided.
error Lapsed(id: string)

# A forge instance this machine knows. comments is EXTENDED (every comment through the message filter's
# inbound check before a run sees it) or TRUSTED (format and size checks alone).
type ForgeInstance (
  # Its host, such as "github.com".
  host: string,
  # The forge adapter that reads it, such as "github".
  adapter: string,
  # EXTENDED or TRUSTED; absent when unreadable is set.
  comments: ?string,
  # Why this instance's entry could not be read; absent when it was.
  unreadable: ?string
)

# The forge instances this machine knows, in the order they were added, and the names of the forge adapters
# installed. Never offered through MCP.
method Forges() -> (forges: []ForgeInstance, adapters: []string)

# Adds a forge instance, or changes the adapter or comment reading of one. comments absent means EXTENDED,
# also for a host that was TRUSTED, so a call that leaves it out only makes the reading stricter. adapter is
# one of Forges' adapters, whose names are the forge kinds they serve. A host that is not a DNS name is
# org.varlink.service.InvalidParameter. The reply is empty. Never offered through MCP: how a forge's words
# reach a run is the owner account's choice.
method ForgeSet(host: string, adapter: string, comments: ?(EXTENDED, TRUSTED)) -> ()

# No forge adapter of that name is installed; nothing was changed.
error AdapterNotInstalled(adapter: string)

# The machine's forge file could not be read or written; reason is for a person. Nothing was changed.
error ForgeFileUnreadable(reason: string)

# Comment, Reply, Comments, ResolveThread or ReviewSummary named no push that waits, or one whose task
# container is not recorded; nothing was kept.
error NoSuchPush()

# The comment's lines are not in that side's file, or are none: a side other than old or new, a startLine
# before 1, an endLine before startLine.
error AnchorOutsideBlob()

# The comment's path is no regular file on that side; a link or a submodule is never followed.
error NotARegularFile()

# The replacement reaches past the comment's lines.
error FixOutsideAnchor()

# A replacement on the old side, which no commit could take.
error OldSideFix()

# A text broke a rule; rule names it, never the text itself: "empty" for a blank text, and a rule of the
# path begins with "path: ", such as "path: empty".
error TextRefused(rule: string)

# A text or a range is over a limit; limit names it.
error TooLarge(limit: string)

# No thread of that id in this push, or none the caller may write in.
error NoSuchThread()

# A cursor no page of this push gave.
error CursorRefused()

# A retry id given before with another comment or reply; nothing was kept.
error IdReused()

# Tries one SSH identity without saving a credential or publishing work. Uses the existing mirror;
# it never initializes or fetches one. source is AGENT (fingerprint or public key id) or FILE (path).
method CredentialTryPush(
  project: string,
  repository: ?string,
  refspec: string,
  source: string,
  id: string
) -> (
  accepted: bool,
  fingerprint: string,
  message: string
)

# Forwarding could not use the chosen SSH identity, or the forge refused an https credential. No raw remote
# output is returned.
error PushRefused(
  # NO_CREDENTIAL, KEY_UNAVAILABLE, or PUSH_REFUSED. Over https only PUSH_REFUSED: the forge refused the token or
  # sign-in offered (source and id name it, "" when none was declared; fingerprint is ""), and message says what
  # to do without repeating git or the server. Any other failed push is not this error.
  outcome: string,
  address: string,
  source: string,
  id: string,
  fingerprint: string,
  # DEPLOY_KEY when the forge said so, otherwise UNKNOWN.
  forge: string,
  # A complete command for a person to start in a terminal, as arguments.
  command: []string,
  message: string
)
# Reads the host's complete published arrival ledger directly, without sudo or a network request.
# project and repository name the host forge's copies; repository casing is folded to lowercase.
# A task's MCP endpoint holds project to the task's own project. Reads
# /etc/porelo-host/organization/arrivals/<project>/<repository>.jsonl, at most 16 MiB,
# only as a regular root-owned file with root-owned directory ancestors, no symlinks,
# and no group/other write permission on any component, as for published central state.
# Missing, unreadable, unsafe, oversized or malformed data is cannot-say, never an empty history.
# Historical judgements are returned unchanged; signatures are not verified again.
# These are pre-receive judgements, not proof that the forge updated its refs.
method Arrivals(project: string, repository: string) -> (
  # read or cannot-say. An armed repository without commits still has an armed row.
  state: string,
  # host-file-unavailable for a missing/unreadable/unsafe file, host-answer-refused for malformed data or names.
  why: ?string,
  # Ledger order. Each row has verdict (accepted, migrated or armed) and arrived (UTC).
  # accepted adds commit, ref and signer (kind, fingerprint, principal, certificate, signed_by);
  # migrated adds commit; armed marks installation of the hook.
  # Empty on cannot-say. An empty file is unavailable, never a successful empty history.
  entries: []object
)
