{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://porelo-ai.github.io/schema/review-profile-1.json",
  "title": "Porelo review profile 1: a SARIF 2.1.0 document the daemon writes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "$schema", "runs", "properties"],
  "properties": {
    "version": { "const": "2.1.0" },
    "$schema": { "const": "https://json.schemastore.org/sarif-2.1.0.json" },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["porelo/profileVersion"],
      "properties": { "porelo/profileVersion": { "const": "1" } }
    },
    "runs": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])" },
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12288,
      "pattern": "^([A-Za-z0-9._~-]|%[0-9A-F]{2})+(/([A-Za-z0-9._~-]|%[0-9A-F]{2})+)*(?![\\s\\S])",
      "not": { "pattern": "(^|/)\\.{1,2}(/|(?![\\s\\S]))" }
    },
    "line": { "type": "integer", "minimum": 1 },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "endLine"],
      "properties": { "startLine": { "$ref": "#/$defs/line" }, "endLine": { "$ref": "#/$defs/line" } }
    },
    "artifactLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": { "uri": { "$ref": "#/$defs/uri" } }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "versionControlProvenance", "columnKind", "results", "properties"],
      "properties": {
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver"],
          "properties": {
            "driver": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "const": "Porelo" } }
            }
          }
        },
        "versionControlProvenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repositoryUri", "revisionId"],
            "properties": {
              "repositoryUri": { "type": "string", "pattern": "^urn:porelo:repository:[A-Za-z0-9._~%-]+:[A-Za-z0-9._~%-]+(?![\\s\\S])" },
              "revisionId": { "$ref": "#/$defs/commit" }
            }
          }
        },
        "columnKind": { "const": "unicodeCodePoints" },
        "results": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/result" } },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["porelo/project", "porelo/repository", "porelo/push", "porelo/completeness"],
          "properties": {
            "porelo/project": { "type": "string", "minLength": 1, "maxLength": 256 },
            "porelo/repository": { "type": "string", "minLength": 1, "maxLength": 256 },
            "porelo/push": { "type": "string", "minLength": 1, "maxLength": 256 },
            "porelo/baseRevisionId": { "$ref": "#/$defs/commit" },
            "porelo/completeness": { "enum": ["complete", "partial", "failed", "unknown"] }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guid", "kind", "level", "message", "locations", "properties"],
      "properties": {
        "guid": { "$ref": "#/$defs/uuid4" },
        "kind": { "const": "review" },
        "level": { "const": "none" },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "\\S" } }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["physicalLocation"],
            "properties": {
              "physicalLocation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["artifactLocation", "region"],
                "properties": {
                  "artifactLocation": { "$ref": "#/$defs/artifactLocation" },
                  "region": { "$ref": "#/$defs/region" }
                }
              }
            }
          }
        },
        "fixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactChanges"],
            "properties": {
              "artifactChanges": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["artifactLocation", "replacements"],
                  "properties": {
                    "artifactLocation": { "$ref": "#/$defs/artifactLocation" },
                    "replacements": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["deletedRegion", "insertedContent"],
                        "properties": {
                          "deletedRegion": { "$ref": "#/$defs/region" },
                          "insertedContent": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["text"],
                            "properties": { "text": { "type": "string", "maxLength": 8192 } }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "porelo/anchorKind",
            "porelo/diffSide",
            "porelo/threadId",
            "porelo/threadState",
            "porelo/sourceKind"
          ],
          "properties": {
            "porelo/anchorKind": { "const": "line" },
            "porelo/diffSide": { "enum": ["old", "new"] },
            "porelo/threadId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "porelo/replyTo": { "type": "string", "minLength": 1, "maxLength": 64 },
            "porelo/threadState": { "enum": ["open", "resolved"] },
            "porelo/sourceKind": { "enum": ["owner-account", "task"] },
            "porelo/taskId": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(?![\\s\\S])" }
          },
          "allOf": [
            {
              "if": { "properties": { "porelo/sourceKind": { "const": "task" } } },
              "then": { "required": ["porelo/taskId"] },
              "else": { "not": { "required": ["porelo/taskId"] } }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "required": ["fixes"] },
          "then": {
            "properties": {
              "properties": {
                "properties": { "porelo/diffSide": { "const": "new" } },
                "not": { "required": ["porelo/replyTo"] }
              }
            }
          }
        }
      ]
    }
  }
}
