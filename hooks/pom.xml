<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo</artifactId>
        <version>0.5.1-SNAPSHOT</version>
    </parent>

    <artifactId>porelo-hooks</artifactId>
    <name>Porelo Hooks</name>
    <description>Porelo - OCI hooks (HOOKS)</description>

    <dependencies>

        <!-- compile -->

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-wire</artifactId>
        </dependency>

    </dependencies>

    <profiles>

        <!-- Requires GraalVM as JAVA_HOME and the musl toolchain at ${musl.home}.
             Produces three statically linked binaries. Static linking is only possible
             because this module makes no FFM call - enforced by NoForeignFunctionMemoryTest. -->

        <profile>
            <id>native</id>
            <properties>
                <porelo.cpu.skip>false</porelo.cpu.skip>
                <porelo.cpu.images>porelo-hook-supervisor,porelo-hook-nft,porelo-hook-reader</porelo.cpu.images>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-porelo-hook-supervisor</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <imageName>porelo-hook-supervisor</imageName>
                                    <mainClass>org.fuin.porelo.hooks.SupervisorHook</mainClass>
                                    <buildArgs combine.children="append">
                                        <buildArg>--static</buildArg>
                                        <buildArg>--libc=musl</buildArg>
                                        <buildArg>-H:CCompilerPath=${musl.gcc}</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>

                            <execution>
                                <id>build-porelo-hook-nft</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <imageName>porelo-hook-nft</imageName>
                                    <mainClass>org.fuin.porelo.hooks.NftHook</mainClass>
                                    <buildArgs combine.children="append">
                                        <buildArg>--static</buildArg>
                                        <buildArg>--libc=musl</buildArg>
                                        <buildArg>-H:CCompilerPath=${musl.gcc}</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>

                            <execution>
                                <id>build-porelo-hook-reader</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <imageName>porelo-hook-reader</imageName>
                                    <mainClass>org.fuin.porelo.hooks.ReaderHook</mainClass>
                                    <buildArgs combine.children="append">
                                        <buildArg>--static</buildArg>
                                        <buildArg>--libc=musl</buildArg>
                                        <buildArg>-H:CCompilerPath=${musl.gcc}</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
