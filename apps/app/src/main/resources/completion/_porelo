#compdef porelo
# zsh completion for porelo.
#
# Same shape as the bash half: the names are alive, so the script asks the program instead of
# carrying a list. 'porelo __complete' takes the words typed so far, the last one being the partial
# word, and answers one candidate per line. It only ever reads.

_porelo() {
    local -a candidates
    # Both expansions are quoted, and that is not style. The partial word is EMPTY whenever the
    # cursor sits after a space - which is most of the times anybody presses TAB - and zsh drops
    # an unquoted empty word from the argument list entirely. Unquoted, 'porelo task <TAB>' reached
    # the program as "porelo task" with no partial word at all, so the last real word was taken as
    # the word being completed and the answer was 'task'. Measured on zsh 5.9.
    candidates=(${(f)"$(${words[1]} __complete -- "${(@)words[1,CURRENT-1]}" "${words[CURRENT]}" 2>/dev/null)"})
    if (( ${#candidates} )); then
        compadd -- $candidates
    fi
    return 0
}

_porelo "$@"
