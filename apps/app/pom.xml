<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-apps</artifactId>
        <version>0.5.1-SNAPSHOT</version>
    </parent>

    <artifactId>porelo-app</artifactId>
    <name>Porelo App</name>
    <description>Porelo - Orchestration and CLI (APP)</description>

    <dependencies>

        <!-- compile -->

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app-base</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app-agents</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app-vault</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app-egress</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app-task</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app-project</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app-gate</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-core</artifactId>
        </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>

        <!-- test -->

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-testing</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- provided: generates the picocli reflection metadata at compile time, so the native
             image needs no hand-written configuration for the command tree. -->

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-wire</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-runtime</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-shield</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-clearance</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-vault</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-gate</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-supervisor</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-agent-api</artifactId>
        </dependency>

    </dependencies>

    <build>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

        </plugins>

    </build>

    <profiles>

        <!-- Requires GraalVM as JAVA_HOME. Produces target/porelo, dynamically linked
             against the build host's glibc: this binary uses Panama FFM, and FFM cannot be
             statically linked because Linker.defaultLookup() dlopens libc.so.6 (spike S5). -->

        <profile>
            <id>native</id>
            <properties>
                <porelo.cpu.skip>false</porelo.cpu.skip>
                <porelo.cpu.images>porelo</porelo.cpu.images>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-porelo</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <imageName>porelo</imageName>
                                    <mainClass>org.fuin.porelo.app.PoreloCli</mainClass>
                                    <buildArgs combine.children="append">
                                        <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                        <!-- A young generation of 16 MiB rather than a tenth of the machine's heap: a
                                             helper lives as long as its task, and garbage that never reached a
                                             collection stayed resident - 186 MB per credential proxy, 44 MB with this
                                             and one collection after the vault opens. -->
                                        <buildArg>-R:MaxNewSize=16777216</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
