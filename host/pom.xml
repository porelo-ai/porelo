<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo</artifactId>
        <version>0.5.1-SNAPSHOT</version>
    </parent>
    <artifactId>porelo-host</artifactId>
    <name>Porelo Host</name>
    <description>The host's own privileged program</description>
    <dependencies>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-organization-git-tree</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-wire</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- -Pnative,ffm-check -Dagent=true fails on an unregistered downcall; -Dporelo.ffm.update=true adds it. -->
        <profile>
            <id>ffm-check</id>
            <properties>
                <porelo.ffm.skip>false</porelo.ffm.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <dependencies>
                            <dependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-ffm-check</artifactId>
                                <version>${porelo.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native</id>
            <properties>
                <porelo.cpu.skip>false</porelo.cpu.skip>
                <porelo.cpu.images>porelo-host</porelo.cpu.images>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-porelo-host</id>
                                <phase>package</phase>
                                <goals><goal>compile-no-fork</goal></goals>
                                <configuration>
                                    <imageName>porelo-host</imageName>
                                    <mainClass>org.fuin.porelo.host.PoreloHost</mainClass>
                                    <buildArgs combine.children="append">
                                        <!-- Caller arguments must never configure the privileged runtime. -->
                                        <buildArg>-H:-ParseRuntimeOptions</buildArg>
                                        <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <dependencies>
                            <dependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-cpu-check</artifactId>
                                <version>${porelo.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
