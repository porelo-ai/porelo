<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-dist</artifactId>
        <version>0.5.1-SNAPSHOT</version>
    </parent>

    <artifactId>porelo-dist-deb</artifactId>
    <packaging>pom</packaging>
    <name>Porelo Debian Package</name>
    <description>Sandboxes AI agent tasks in hardened rootless containers</description>

    <properties>
        <!-- The package name, which is not the module name: the module builds the package, the
             package is what an operator installs and what an agent package depends on. -->
        <package.name>porelo</package.name>
        <hook.install.dir>/usr/libexec/porelo/hooks</hook.install.dir>
        <!-- Data files an operator can add to, not executables, so share rather than libexec. -->
        <provider.install.dir>/usr/share/porelo/providers</provider.install.dir>
        <egress.install.dir>/usr/share/porelo/egress</egress.install.dir>
        <selinux.install.dir>/usr/share/porelo/selinux</selinux.install.dir>
        <sbom.install.dir>/usr/share/porelo/sbom</sbom.install.dir>
        <setup.install.dir>/usr/share/porelo/setup</setup.install.dir>
    </properties>

    <!-- The shipped executables' runtime closure supplies the bill and notices, and orders the reactor before packaging. -->
    <dependencies>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelod</artifactId>
        </dependency>
        <!-- Reactor ordering only: the separate host package must not enter porelo's bill. -->
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-host</artifactId>
            <version>${porelo.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-hooks</artifactId>
        </dependency>
    </dependencies>

    <profiles>

        <!-- Requires -Pnative to have produced the binaries; run as: mvn -Pnative,dist verify -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>

                    <!-- The bill the package installs, from this module's own dependencies: the
                         three that ship and what they pull in, compile and runtime. It was an
                         aggregate over the whole reactor, which put the acceptance kit's cucumber,
                         junit and sshj and the build tools' libraries into what an operator reads
                         as the contents of the package. Written where the rpm and the publishing
                         step have always read it. -->
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>cyclonedx-package</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                                <configuration>
                                    <projectType>application</projectType>
                                    <outputDirectory>${project.basedir}/../../target</outputDirectory>
                                    <outputName>porelo.cdx</outputName>
                                    <!-- Nothing here is deployed to Maven: the package is what ships. -->
                                    <skipNotDeployed>false</skipNotDeployed>
                                    <skipAttach>true</skipAttach>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- After package the reactor supplies jars, never classes directories; only third-party jars need notices. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>third-party-classpath</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>build-classpath</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <excludeGroupIds>org.fuin.porelo</excludeGroupIds>
                                    <outputFile>${project.build.directory}/third-party-classpath.txt</outputFile>
                                    <regenerateFile>true</regenerateFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Both packages read this one generated file, from the bill above and the native build's JDK. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>third-party-notices</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <executableDependency>
                                        <groupId>org.fuin.porelo</groupId>
                                        <artifactId>porelo-release</artifactId>
                                    </executableDependency>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>org.fuin.porelo.release.Main</argument>
                                        <argument>third-party-notices</argument>
                                        <argument>${project.build.directory}/third-party-classpath.txt</argument>
                                        <argument>${project.basedir}/../../target/porelo.cdx.json</argument>
                                        <argument>${java.home}</argument>
                                        <argument>${project.basedir}/../../target/THIRD-PARTY-NOTICES</argument>
                                        <argument>--own</argument>
                                        <argument>org\.fuin\.porelo:.*</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.vafer</groupId>
                        <artifactId>jdeb</artifactId>
                        <version>${jdeb.version}</version>
                        <executions>
                            <execution>
                                <id>deb</id>
                                <!-- 'verify' for the same reason as the agents: native-image binds
                                     to 'package' and inherited plugins run first. -->
                                <phase>verify</phase>
                                <goals>
                                    <goal>jdeb</goal>
                                </goals>
                                <configuration>
                                    <name>${package.name}</name>
                                    <deb>${project.build.directory}/${package.name}_${porelo.package.version}_amd64.deb</deb>
                                    <controlDir>${project.basedir}/src/deb/control</controlDir>
                                    <skipPOMs>false</skipPOMs>
                                    <dataSet>
                                        <data>
                                            <src>${project.basedir}/../../providers</src>
                                            <type>directory</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${provider.install.dir}</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../egress</src>
                                            <type>directory</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${egress.install.dir}</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../apps/app/target/porelo</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/bin</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../daemon/target/porelod</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/bin</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../hooks/target/porelo-hook-nft</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${hook.install.dir}</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../hooks/target/porelo-hook-supervisor</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${hook.install.dir}</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../hooks/target/porelo-hook-reader</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${hook.install.dir}</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- Source, not a compiled module: a .pp is tied to the policy version of the machine that built it. -->
                                        <data>
                                            <src>${project.basedir}/../../selinux/porelo_socket.te</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${selinux.install.dir}</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../selinux/install-selinux-policy.sh</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${selinux.install.dir}</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- The AppArmor profiles, deb only: Fedora and RHEL do not run AppArmor.
                                             Conffiles under /etc/apparmor.d, where the machine loads them at
                                             boot and an administrator's change survives an update; postinst
                                             loads them, postrm unloads them. -->
                                        <data>
                                            <src>${project.basedir}/../../apparmor/porelo</src>
                                            <type>file</type>
                                            <conffile>true</conffile>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/etc/apparmor.d</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../apparmor/porelo-task</src>
                                            <type>file</type>
                                            <conffile>true</conffile>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/etc/apparmor.d</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- The setup script, so a machine that added the repository by its pinned
                                             key gets it checked by apt, as it checks this package. -->
                                        <data>
                                            <src>${project.basedir}/../dist-setup/porelo-setup.sh</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${setup.install.dir}</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- The bill of what this package carries. Payload, not
                                             documentation: under /usr/share/doc it would be
                                             excluded from the deb side of the parity check and
                                             not from the rpm side. -->
                                        <data>
                                            <src>${project.basedir}/../../target/porelo.cdx.json</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${sbom.install.dir}</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- A user unit, installed and not enabled: starting a
                                             daemon is the operator's decision, and a package that
                                             started one would start it for every account. -->
                                        <data>
                                            <src>${project.basedir}/../../systemd/porelod.service</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/lib/systemd/user</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- TAB completion. The file name IS the command name
                                             for bash, and '_<command>' for zsh, which is why the
                                             two resources are named the way they are rather than
                                             by shell. Debian puts vendor completions under
                                             vendor-completions; Fedora has no such directory and
                                             uses site-functions, which is the second place where
                                             the two ecosystems differ on purpose. Both are
                                             checked in dist/package-check. -->
                                        <data>
                                            <src>${project.basedir}/../../apps/app/src/main/resources/completion/porelo</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/bash-completion/completions</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../apps/app/src/main/resources/completion/_porelo</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/zsh/vendor-completions</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../target/THIRD-PARTY-NOTICES</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/doc/${package.name}</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- Debian Policy 12.5: every binary package ships one. -->
                                        <data>
                                            <src>${project.basedir}/src/deb/copyright/copyright</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/doc/${package.name}</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                    </dataSet>
                                </configuration>
                            </execution>
                            <execution>
                                <id>deb-host</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jdeb</goal>
                                </goals>
                                <configuration>
                                    <name>porelo-host</name>
                                    <deb>${project.build.directory}/porelo-host_${porelo.package.version}_amd64.deb</deb>
                                    <controlDir>${project.basedir}/src/deb-host/control</controlDir>
                                    <skipPOMs>false</skipPOMs>
                                    <dataSet>
                                        <data>
                                            <src>${project.basedir}/../../host/target/porelo-host</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/sbin</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../../host/src/main/man/porelo-host.8</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/man/man8</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- The host's binary compiles in a part of porelo's closure, so the same notices cover it. -->
                                        <data>
                                            <src>${project.basedir}/../../target/THIRD-PARTY-NOTICES</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/doc/porelo-host</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/src/deb/copyright/copyright</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/doc/porelo-host</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                    </dataSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

    </profiles>

</project>
