<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-dist</artifactId>
        <version>0.5.1-SNAPSHOT</version>
    </parent>

    <artifactId>porelo-dist-rpm</artifactId>
    <packaging>pom</packaging>
    <name>Porelo RPM Package</name>
    <description>Sandboxes AI agent tasks in hardened rootless containers</description>

    <properties>
        <package.name>porelo</package.name>
        <hook.install.dir>/usr/libexec/porelo/hooks</hook.install.dir>
        <provider.install.dir>/usr/share/porelo/providers</provider.install.dir>
        <egress.install.dir>/usr/share/porelo/egress</egress.install.dir>
        <selinux.install.dir>/usr/share/porelo/selinux</selinux.install.dir>
        <sbom.install.dir>/usr/share/porelo/sbom</sbom.install.dir>
        <!-- Signing is off for local and CI builds and on for releases, where the key exists. -->
        <rpm.sign.skip>true</rpm.sign.skip>
    </properties>

    <!-- Reactor ordering only; see the note in dist-deb. -->
    <dependencies>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-app</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelod</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-hooks</artifactId>
        </dependency>
    </dependencies>

    <profiles>

        <!-- Requires -Pnative to have produced the binaries; run as: mvn -Pnative,dist package -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>


                    <plugin>
                        <groupId>de.dentrassi.maven</groupId>
                        <artifactId>rpm</artifactId>
                        <executions>
                            <execution>
                                <id>rpm</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>rpm</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <packageName>${package.name}</packageName>
                            <version>${porelo.package.version}</version>
                            <snapshotVersion>${porelo.package.version}</snapshotVersion>
                            <release>1</release>
                            <summary>${project.description}</summary>
                            <description>Sandboxes an AI agent task in a hardened, rootless podman container: egress is default-deny, credentials stay on the host behind a broker, and the agent hands its work back through a git gate the operator reviews.

Installs the porelo and porelod binaries and the three OCI hooks. The hooks are NOT registered by this package: podman reads hook descriptors per user, so each operator runs "porelo setup" once. Nothing here touches a system-wide podman configuration.

This package contains no agent. Agents ship separately as porelo-agent-* packages, which porelo discovers by scanning /usr/libexec/porelo/agents.

Where SELinux is enforcing, a task container cannot reach porelo's sockets until the policy module in /usr/share/porelo/selinux is installed. "porelo doctor" reports whether it is.</description>
                            <!-- Without this the plugin substitutes a timestamp release for any
                                 snapshot build, and the rpm and the deb then disagree about what
                                 version they are. -->
                            <forceRelease>true</forceRelease>
                            <architecture>x86_64</architecture>
                            <group>Applications/System</group>
                            <license>GPL-3.0-or-later</license>
                            <packager>Michael Schnell &lt;michael@fuin.org&gt;</packager>
                            <requires>
                                <!-- Podman 5 as setup demands, with Fedora's epoch: without one rpm reads epoch 0 and 5:4.9 passes. -->
                                <require>podman &gt;= 5:5.0</require>
                                <require>nftables</require>
                                <require>dnsmasq</require>
                                <require>git</require>
                                <require>util-linux</require>
                                <!-- The C library and zlib at the floor the binaries were measured to need: the
                                     plugin does not read them. -->
                                <require>libc.so.6(GLIBC_${package.glibc.floor})(64bit)</require>
                                <require>libz.so.1(ZLIB_${package.zlib.floor})(64bit)</require>
                            </requires>
                            <!-- Recommended, not required: they require porelo, so requiring them would
                                 be a cycle. dnf installs a weak dependency by default, which is what a
                                 machine without the setup script needs - without the filter nothing
                                 leaves a task. -->
                            <recommends>
                                <recommend>porelo-message-sluice-filter</recommend>
                            </recommends>
                            <!-- On an upgrade only, and only where the module is loaded: a loaded module stays as it was
                                 when its package is replaced, and the one before 1.1 let no sshd domain connect, so every
                                 socket forward was reset. Reloading the same module is harmless; a machine that never
                                 loaded it is left alone. Never fails the upgrade. -->
                            <afterInstallation>
                                <interpreter>/bin/sh</interpreter>
                                <script><![CDATA[
if [ "$1" -ge 2 ] && command -v semodule >/dev/null 2>&1 && semodule -l 2>/dev/null | grep -Eq "^porelo_socket([[:space:]]|$)"; then
    if command -v checkmodule >/dev/null 2>&1 && command -v semodule_package >/dev/null 2>&1; then
        /usr/share/porelo/selinux/install-selinux-policy.sh >/dev/null 2>&1 \
            || echo "porelo: reloading the SELinux module failed; run: sudo /usr/share/porelo/selinux/install-selinux-policy.sh"
    else
        echo "porelo: the SELinux module was not reloaded, checkpolicy is not installed; install it and run: sudo /usr/share/porelo/selinux/install-selinux-policy.sh"
    fi
fi
exit 0
]]></script>
                            </afterInstallation>
                            <signature>
                                <skip>${rpm.sign.skip}</skip>
                            </signature>
                            <entries>
                                <!-- Declarations an operator can add to, not executables. Collected rather
                                     than listed, as the egress sets are: a provider added to providers/ ships in
                                     both packages without anyone remembering to edit this file. -->
                                <entry>
                                    <name>${provider.install.dir}</name>
                                    <collect>
                                        <from>${project.basedir}/../../providers</from>
                                        <includes>
                                            <include>*.yaml</include>
                                        </includes>
                                    </collect>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <!-- Collected rather than listed: a set added to egress/ ships
                                     without anyone remembering to edit this file. -->
                                <entry>
                                    <name>${egress.install.dir}</name>
                                    <collect>
                                        <from>${project.basedir}/../../egress</from>
                                        <includes>
                                            <include>*.yaml</include>
                                        </includes>
                                    </collect>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <entry>
                                    <name>/usr/bin/porelo</name>
                                    <file>${project.basedir}/../../apps/app/target/porelo</file>
                                    <mode>0755</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <entry>
                                    <name>/usr/bin/porelod</name>
                                    <file>${project.basedir}/../../daemon/target/porelod</file>
                                    <mode>0755</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <entry>
                                    <name>${hook.install.dir}/porelo-hook-nft</name>
                                    <file>${project.basedir}/../../hooks/target/porelo-hook-nft</file>
                                    <mode>0755</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <entry>
                                    <name>${hook.install.dir}/porelo-hook-supervisor</name>
                                    <file>${project.basedir}/../../hooks/target/porelo-hook-supervisor</file>
                                    <mode>0755</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <entry>
                                    <name>${hook.install.dir}/porelo-hook-reader</name>
                                    <file>${project.basedir}/../../hooks/target/porelo-hook-reader</file>
                                    <mode>0755</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <!-- Source, not a compiled module: a .pp is tied to the policy version of the machine that built it. -->
                                <entry>
                                    <name>${selinux.install.dir}/porelo_socket.te</name>
                                    <file>${project.basedir}/../../selinux/porelo_socket.te</file>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <entry>
                                    <name>${selinux.install.dir}/install-selinux-policy.sh</name>
                                    <file>${project.basedir}/../../selinux/install-selinux-policy.sh</file>
                                    <mode>0755</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <entry>
                                    <name>${sbom.install.dir}/porelo.cdx.json</name>
                                    <file>${project.basedir}/../../target/porelo.cdx.json</file>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <!-- A user unit, installed and not enabled. Same path on both
                                     distributions, unlike the zsh completion below. -->
                                <entry>
                                    <name>/usr/lib/systemd/user/porelod.service</name>
                                    <file>${project.basedir}/../../systemd/porelod.service</file>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <!-- TAB completion. Fedora's zsh reads site-functions and has
                                     no vendor-completions, which is where the deb puts the same
                                     file - the second place the two ecosystems differ on purpose,
                                     after the license. -->
                                <entry>
                                    <name>/usr/share/bash-completion/completions/porelo</name>
                                    <file>${project.basedir}/../../apps/app/src/main/resources/completion/porelo</file>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <entry>
                                    <name>/usr/share/zsh/site-functions/_porelo</name>
                                    <file>${project.basedir}/../../apps/app/src/main/resources/completion/_porelo</file>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <!-- 'license' marks it %license, so 'rpm -qL' answers. -->
                                <entry>
                                    <name>/usr/share/licenses/${package.name}/LICENSE</name>
                                    <file>${project.basedir}/../../LICENSE</file>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                    <license>true</license>
                                </entry>
                            </entries>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

    </profiles>

</project>
